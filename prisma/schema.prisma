generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Incident {
  id               String   @id
  maestroCaseId    String?
  title            String
  source           String
  status           String
  severity         String
  agentActivity    String   // JSON stringified array
  auditTrail       String   // JSON stringified array
  metrics          String   // JSON stringified object
  rootCause        String?
  proposedSolution String?
  codeSnippet      String?
  terminalLog      String?
  diagnosticPlan   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
